---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import FormattedDate from '@components/FormattedDate.astro';

type Props = {
  title: string;
  description: string;
  date: Date;
  image: ImageMetadata;
  imageAlt: string;
  href: string;
  source: string;
  /** Heading level for the title: one below the heading the list sits under */
  level?: 2 | 3 | 4;
};
const {
  href,
  source,
  title,
  description,
  date,
  image,
  imageAlt,
  level = 3,
} = Astro.props;
const Heading = `h${level}` as const;
---

<style>
  .list-item__lab {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  /* Same size at every heading level */
  .list-item__title {
    font-size: 1.2em;
  }

  .list-item__description {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.25;
    margin-top: 0.25rem;
  }

  .list-item__lab__image {
    flex-shrink: 0;
    aspect-ratio: 1/1;
    width: 5rem;
    height: auto;
    border-radius: 0.5rem;
    background-color: var(--surface-sunken);
  }

  .list-item__lab__content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .list-item__meta-list {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
</style>

<li class="list-item__lab">
  <Image
    class="list-item__lab__image"
    src={image}
    alt={imageAlt}
    width={80}
    densities={[1, 2]}
  />
  <div class="list-item__lab__content">
    <div>
      <Heading class="list-item__title">{title}</Heading>
      <p class="list-item__description">{description}</p>
    </div>
    <div class="list-item__meta-list">
      <p class="list-item__date">
        <FormattedDate date={date} />
      </p>
      {href && <a href={href}>View</a>}
      {source && <a href={source}>Source</a>}
    </div>
  </div>
</li>
