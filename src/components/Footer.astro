---
import { links } from '@components/Header.astro';
const today = new Date();
---

<footer class="grid-layout grain">
  <div class="footer-content">
    <div class="footer__meta">
      <p>&copy; {today.getFullYear()} Nathan Long</p>
      <p>
        <a href="#">Certified Trackerless Web Burger</a>
        <span>&trade;</span>
      </p>
    </div>

    <nav>
      <ul class="footer-nav__list">
        {links.map((link, i) => (
          <li style={`--i: ${i}`}>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  footer {
    margin-top: 2rem;
    padding: 2rem 0;
    /* Under the grain (see .grain in global.css) */
    --grain-base: linear-gradient(var(--surface-gradient));
    color: var(--text-muted);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    align-items: center;
  }

  .footer-nav__list {
    list-style: none;
    font-size: 0.75rem;
    display: flex;
    gap: 0.5rem;
    padding: 0;
  }
</style>
