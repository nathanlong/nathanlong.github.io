---
import GithubIcon from '@components/icons/github.svg';
import CodepenIcon from '@components/icons/codepen.svg';
import LinkedinIcon from '@components/icons/linkedin.svg';
import RssIcon from '@components/icons/rss.svg';
const today = new Date();
---

<footer class="grid-layout">
  <div class="">👋</div>
  <div class="footer-content">
    <p>&copy; {today.getFullYear()} Nathan Long</p>
    <p>
      <a href="/trackerless">Certified Trackerless Web Burger</a>
      <span>&trade;</span>
    </p>
  </div>
  <div class="footer-content">
    <ul class="footer__links">
      <li>
        <a href="https://github.com/nathanlong">
          <GithubIcon class="footer__icon" />
        </a>
      </li>
      <li>
        <a href="https://codepen.io/nathanlong">
          <CodepenIcon class="footer__icon" />
        </a>
      </li>
      <li>
        <a href="https://www.linkedin.com/in/nathanmlong/">
          <LinkedinIcon class="footer__icon" />
        </a>
      </li>
      <li>
        <a href="/rss.xml">
          <RssIcon class="footer__icon" />
        </a>
      </li>
    </ul>
  </div>
</footer>

<style>
  footer {
    margin-top: 2rem;
    padding: 2rem 0;
    color: var(--text-muted);
    text-align: center;
  }

  .footer-content {
    font-size: 0.75rem;
  }

  .footer__links {
    margin-top: 1.5rem;
    display: flex;
    list-style: none;
    padding: 0;
    gap: 1em;
    justify-content: center;
    align-items: center;
  }

  .footer__icon {
    width: 2rem;
  }
</style>
