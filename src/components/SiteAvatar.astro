---
import { Image } from 'astro:assets';
import Profile from '@/assets/images/avatar-base.png';
import { AVATAR_HEIGHT_PX, AVATAR_DENSITIES } from '@/consts';

// The hat's image comes from the data-hat rules Header puts on <html>.
const avatarRatio = `${Profile.width} / ${Profile.height}`;
---

<span class="site-avatar" style={`--avatar-ratio: ${avatarRatio}`}>
  <Image
    src={Profile}
    class="site-avatar-image"
    height={AVATAR_HEIGHT_PX}
    densities={AVATAR_DENSITIES}
    loading="eager"
    alt=""
  />
  <span class="site-avatar-hat" aria-hidden="true"></span>
</span>

<style>
  .site-avatar {
    /* Blockified in a flex row anyway; this sizes it the same in a block link */
    display: block;
    position: relative;
    flex: none;
    height: 2.5rem;
    aspect-ratio: var(--avatar-ratio);
  }

  .site-avatar-image {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 0;
  }

  /* The hat shares the avatar's canvas, so it sits in place at the same
     size. It waits above, hidden, and drops on with a little bounce when the
     link around the avatar is hovered or focused. */
  .site-avatar-hat {
    position: absolute;
    inset: 0;
    background: no-repeat center / contain;
    opacity: 0;
    translate: 0 -60%;
    transition:
      translate 0.2s ease-in,
      opacity 0.15s ease-in;
    pointer-events: none;
  }

  :global(a:is(:hover, :focus-visible)) .site-avatar-hat {
    opacity: 1;
    translate: 0 0;
    transition:
      translate 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.1s ease-out;
  }

  /* The hat fades on in place instead of dropping */
  @media (prefers-reduced-motion: reduce) {
    .site-avatar-hat {
      translate: 0 0;
    }
  }
</style>
