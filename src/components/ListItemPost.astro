---
import FormattedDate from '@components/FormattedDate.astro';

type Props = {
  title: string;
  date: Date;
  /** Heading level for the title: one below the heading the list sits under */
  level?: 2 | 3 | 4;
} & (
  | { href: string; id?: never; section?: never }
  | { id: string; section?: string; href?: never }
);

const { id, section = 'blog', href, title, date, level = 3 } = Astro.props;
const link = href ?? `/${section}/${id}/`;
const Heading = `h${level}` as const;
---

<style is:global>
  .list-item__post * {
    text-decoration: none;
  }

  .list-item__link {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .list-item__link:hover .list-item__title,
  .list-item__link:focus .list-item__title {
    color: var(--accent);
  }

  .list-item__title {
    /* Same size at every heading level */
    font-size: 1.2em;
    color: var(--text-strong);
    line-height: 1;
    margin: 0;
    transition: color 150ms ease-in-out;
  }

  .list-item__date {
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: 0.7em;
  }
</style>

<li class="list-item__post">
  <a class="list-item__link" href={link}>
    <Heading class="list-item__title">{title}</Heading>
    <p class="list-item__date">
      <FormattedDate date={date} />
    </p>
  </a>
</li>
