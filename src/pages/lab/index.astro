---
import { getCollection } from 'astro:content';
import BaseHead from '@components/BaseHead.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import ListItemLab from '@/components/ListItemLab.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';

const experiments = (await getCollection('lab')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<style>
  .list-item--grid {
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="grid-layout">
      <h2>Lab</h2>
      <section>
        <ul class="list-item--grid">
          {experiments.map((experiment) => (
            <ListItemLab
              title={experiment.data.name}
              description={experiment.data.description}
              image={experiment.data.image}
              imageAlt={experiment.data.imageAlt}
              date={experiment.data.pubDate}
              href={experiment.data.url}
              source={experiment.data.source}
            />
          ))}
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
