---
import BaseHead from '@components/BaseHead.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import ListItemLab from '@/components/ListItemLab.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import { getExperiments, lastTouched } from '@/data/lab';

const experiments = await getExperiments();
---

<style>
  .list-item--grid {
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="grid-layout flow flow-2">
      <section class="flow">
        <h1>Lab</h1>
        <p class="flow-1/2">Side projects, demos, random things I've built...</p>
      </section>
      <section>
        <ul class="list-item--grid">
          {experiments.map((experiment) => (
            <ListItemLab
              title={experiment.data.name}
              description={experiment.data.description}
              image={experiment.data.image}
              imageAlt={experiment.data.imageAlt}
              date={lastTouched(experiment)}
              href={experiment.data.url}
              source={experiment.data.source}
            />
          ))}
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
