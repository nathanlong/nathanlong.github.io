---
// src/pages/tags/[tag].astro
import { getCollection } from 'astro:content';
import BaseHead from '@components/BaseHead.astro';
import Footer from '@components/Footer.astro';
import FormattedDate from '@components/FormattedDate.astro';
import Header from '@components/Header.astro';
import ListItemPost from '@/components/ListItemPost.astro';
import { SITE_DESCRIPTION } from '@/consts';

// 1. Generate paths for all unique tags at build time
export async function getStaticPaths() {
  const allPosts = await getCollection('blog');

  // Extract a unique list of tags across all blog posts
  const uniqueTags = [
    ...new Set(allPosts.map((post) => post.data.tags).flat()),
  ];

  // Return a list of path segments and pass filtered posts as props
  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post) =>
      post.data.tags.includes(tag),
    );
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

// 2. Retrieve route params and page props
const { tag } = Astro.params;
const { posts } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Tagged with ${tag}`}
      description={SITE_DESCRIPTION}
    />
  </head>
  <body>
    <Header />
    <main class="grid-layout">
      <h2>Tagged with {tag}</h2>
      <ul class="list-item">
        {posts.map((post) => (
          <ListItemPost
            id={post.id}
            title={post.data.title}
            date={post.data.pubDate}
          />
        ))}
      </ul>
    </main>
    <Footer />
  </body>
</html>
