---
import { getCollection } from 'astro:content';
import BaseHead from '@components/BaseHead.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import { SITE_DESCRIPTION } from '@/consts';

const allPosts = await getCollection("blog");
// Extract flat array of unique, sorted tags
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())].sort();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Tags" description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="grid-layout">
      <section class="flow">
        <h1>Tags</h1>
        <p class="flow-1/2">Certain topics I tend to write about:</p>
        <ul class="post-tags post-tags--column">
          {tags.map((tag) => (
            <li>
              <a href={`/tags/${tag}/`}>
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
