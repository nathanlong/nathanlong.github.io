---
import BaseHead from '@components/BaseHead.astro';
import Button from '@components/Button.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import ListItemPost from '@components/ListItemPost.astro';
import SectionHeader from '@components/SectionHeader.astro';
import SubscribeCard from '@components/SubscribeCard.astro';
import { SITE_TITLE } from '@/consts';
import { NEWSLETTER, getIssues } from '@/data/newsletter';

const DESCRIPTION =
  'Every week I spew out thoughts, links, and occasional insights about working in the web industry.';

const issues = (await getIssues()).slice(0, 8);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Newsletter | ${SITE_TITLE}`} description={DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="grid-layout flow flow-2">
      <section class="flow">
        <h1>Newsletter</h1>
        <p class="flow-1/2">{DESCRIPTION}</p>
      </section>

      <SubscribeCard class="popout" />

      <section class="flow flow-2">
        <SectionHeader
          title="Recent issues"
          href={NEWSLETTER.archive}
          note="external"
          linkLabel="Archive"
        />
        {issues.length > 0 ? (
          <ul class="list-item">
            {issues.map((issue) => (
              <ListItemPost
                href={issue.href}
                title={issue.title}
                date={issue.date}
              />
            ))}
          </ul>
        ) : (
          <p>
            Catch up on every issue in{' '}
            <a href={NEWSLETTER.archive}>the archive</a>.
          </p>
        )}
        <Button href={NEWSLETTER.archive}>See more in the Archives</Button>
      </section>
    </main>
    <Footer />
  </body>
</html>

