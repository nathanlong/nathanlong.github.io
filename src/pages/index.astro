---
import { getCollection } from 'astro:content';
import BaseHead from '@components/BaseHead.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import ListItemPost from '@components/ListItemPost.astro';
import ListItemLab from '@/components/ListItemLab.astro';
import SectionHeader from '@components/SectionHeader.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import { getExperiments, lastTouched } from '@/data/lab';
import { NEWSLETTER, getIssues } from '@/data/newsletter';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const experiments = (await getExperiments()).slice(0, 3);

const latestNews = (await getIssues()).slice(0, 3);
---

<style>
  .list-item__lab {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .list-item__lab__image {
    aspect-ratio: 1/1;
    width: 5rem;
    border-radius: 0.5rem;
    background-color: var(--surface-sunken);
  }

  .list-item__meta-list {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 0.825rem;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="grid-layout flow flow-2">
      <section>
        <p>
          UI Designer at <a href="https://www.viget.com">Viget</a>. Keeping the
          internet weird one website at a time.
        </p>
      </section>

      <section class="flow flow-2">
        <SectionHeader title="Blog" href="/blog" />
        <ul class="list-item">
          {posts.map((post) => (
            <ListItemPost
              id={post.id}
              section="blog"
              title={post.data.title}
              date={post.data.pubDate}
            />
          ))}
        </ul>
      </section>

      <section class="flow flow-2">
        <SectionHeader title="Lab" href="/lab" />
        <ul class="list-item">
          {experiments.map((experiment) => (
            <ListItemLab
              title={experiment.data.name}
              image={experiment.data.image}
              imageAlt={experiment.data.imageAlt}
              date={lastTouched(experiment)}
              href={experiment.data.url}
              source={experiment.data.source}
            />
          ))}
        </ul>
      </section>
      <section class="flow flow-2">
        <SectionHeader
          title="Newsletter"
          note="external"
          href={NEWSLETTER.archive}
        />
        <ul class="list-item">
          {latestNews.map((item) => (
            <ListItemPost
              href={item.href}
              title={item.title}
              date={item.date}
            />
          ))}
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
