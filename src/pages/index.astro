---
import Parser from 'rss-parser';
import { getCollection } from 'astro:content';
import BaseHead from '@components/BaseHead.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import FormattedDate from '@components/FormattedDate.astro';
import ListItemPost from '@components/ListItemPost.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const experiments = (await getCollection('lab'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const parser = new Parser();
const newsletter = await parser.parseURL(
  'https://buttondown.com/nathanlong/rss',
);
// Feed fields are all optional, so skip anything incomplete and parse dates
const latestNews = newsletter.items
  .flatMap(({ link, title, isoDate, pubDate }) => {
    const date = isoDate ?? pubDate;
    return link && title && date
      ? [{ href: link, title, date: new Date(date) }]
      : [];
  })
  .slice(0, 3);
---

<style>
  .list-item__lab {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .list-item__lab__image {
    aspect-ratio: 1/1;
    width: 5rem;
    border-radius: 0.5rem;
    background-color: rgb(var(--light-gray));
  }

  .list-item__meta-list {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 0.825rem;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="grid-layout flow">
      <section>
        <p>
          UI Designer at <a href="https://www.viget.com">Viget</a>. Keeping the
          internet weird one website at a time.
        </p>
      </section>
      <hr />
      <h2>Blog</h2>
      {/* turn into component */}
      <ul class="list-item">
        {posts.map((post) => (
          <ListItemPost
            id={post.id}
            section="blog"
            title={post.data.title}
            date={post.data.pubDate}
          />
        ))}
      </ul>
      <hr />
      <h2>Lab</h2>
      <ul class="list-item">
        {experiments.map((experiment) => (
          <li class="list-item__lab">
            <img
              class="list-item__lab__image"
              src={experiment.data.image}
              alt={experiment.data.imageAlt}
            />
            <div>
              <h4 class="list-item__title">{experiment.data.name}</h4>
              <div class="list-item__meta-list">
                <p class="list-item__date">
                  <FormattedDate date={experiment.data.pubDate} />
                </p>
                {experiment.data.url && <a href={experiment.data.url}>View</a>}
                {experiment.data.source && (
                  <a href={experiment.data.source}>Source</a>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
      <hr />
      <h2>Newsletter</h2>
      <ul class="list-item">
        {latestNews.map((item) => (
          <ListItemPost href={item.href} title={item.title} date={item.date} />
        ))}
      </ul>
    </main>
    <Footer />
  </body>
</html>
