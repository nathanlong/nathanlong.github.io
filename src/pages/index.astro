---
import Parser from 'rss-parser';
import { getCollection } from 'astro:content';
import BaseHead from '@components/BaseHead.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import ListItemPost from '@components/ListItemPost.astro';
import ListItemLab from '@/components/ListItemLab.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const experiments = (await getCollection('lab'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const parser = new Parser();
const newsletter = await parser.parseURL(
  'https://buttondown.com/nathanlong/rss',
);
// Feed fields are all optional, so skip anything incomplete and parse dates
const latestNews = newsletter.items
  .flatMap(({ link, title, isoDate, pubDate }) => {
    const date = isoDate ?? pubDate;
    return link && title && date
      ? [{ href: link, title, date: new Date(date) }]
      : [];
  })
  .slice(0, 3);
---

<style>
  .list-item__lab {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .list-item__lab__image {
    aspect-ratio: 1/1;
    width: 5rem;
    border-radius: 0.5rem;
    background-color: var(--surface-sunken);
  }

  .list-item__meta-list {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 0.825rem;
  }

  .section-header {
    display: flex;
    flex-directin: row;
    align-items: baseline;
    gap: 1rem;
  }

  .section-title {
    flex-shrink: 0;
  }

  .section-title small {
    font-weight: normal;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .section-header__link {
    flex-shrink: 0;
    font-size: 0.75rem;
    text-decoration: none;
  }

  .spacer {
    width: 100%;
    border-bottom: 3px dotted var(--surface-sunken);
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="grid-layout flow flow-2">
      <section>
        <p>
          UI Designer at <a href="https://www.viget.com">Viget</a>. Keeping the
          internet weird one website at a time.
        </p>
      </section>

      <section class="flow flow-2">
        <div class="section-header">
          <h2 class="section-title">Blog</h2>
          <div class="spacer"></div>
          <a class="section-header__link" href="/blog">
            View All &rarr;
          </a>
        </div>
        <ul class="list-item">
          {posts.map((post) => (
            <ListItemPost
              id={post.id}
              section="blog"
              title={post.data.title}
              date={post.data.pubDate}
            />
          ))}
        </ul>
      </section>

      <section class="flow flow-2">
        <div class="section-header">
          <h2 class="section-title">Lab</h2>
          <div class="spacer"></div>
          <a class="section-header__link" href="/lab">
            View All &rarr;
          </a>
        </div>
        <ul class="list-item">
          {experiments.map((experiment) => (
            <ListItemLab
              title={experiment.data.name}
              image={experiment.data.image}
              imageAlt={experiment.data.imageAlt}
              date={experiment.data.pubDate}
              href={experiment.data.url}
              source={experiment.data.source}
            />
          ))}
        </ul>
      </section>
      <section class="flow flow-2">
        <div class="section-header">
          <h2 class="section-title">
            Newsletter <small>(external)</small>
          </h2>
          <div class="spacer"></div>
          <a
            class="section-header__link"
            href="https://buttondown.com/nathanlong/archive/"
          >
            View All &rarr;
          </a>
        </div>
        <ul class="list-item">
          {latestNews.map((item) => (
            <ListItemPost
              href={item.href}
              title={item.title}
              date={item.date}
            />
          ))}
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
