---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '@components/BaseHead.astro';
import Footer from '@components/Footer.astro';
import FormattedDate from '@components/FormattedDate.astro';
import Header from '@components/Header.astro';
import ListItemPost from '@/components/ListItemPost.astro';
import { SITE_DESCRIPTION, SITE_TIMEZONE, SITE_TITLE } from '@/consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Group posts by year, newest first (Map keeps the sorted insertion order)
const postsByYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = Number(
    post.data.pubDate.toLocaleDateString('en-US', {
      year: 'numeric',
      timeZone: SITE_TIMEZONE,
    }),
  );
  postsByYear.set(year, [...(postsByYear.get(year) ?? []), post]);
}

const tags = [...new Set(posts.map((post) => post.data.tags).flat())].sort();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="grid-layout">
      <section>
        Tags:
        {tags.map((tag) => (
          <a href={`/tags/${tag}/`}>{tag}</a>
        ))}
      </section>
      {[...postsByYear].map(([year, yearPosts]) => (
        <section>
          <h2>{year}</h2>
          <ul class="list-item">
            {yearPosts.map((post) => (
              <ListItemPost
                id={post.id}
                title={post.data.title}
                date={post.data.pubDate}
              />
            ))}
          </ul>
        </section>
      ))}
    </main>
    <Footer />
  </body>
</html>
