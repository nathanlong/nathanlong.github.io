---
import { getCollection } from 'astro:content';
import BaseHead from '@components/BaseHead.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ListItemPost from '@/components/ListItemPost.astro';
import { SITE_DESCRIPTION, SITE_TIMEZONE } from '@/consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Group posts by year, newest first (Map keeps the sorted insertion order)
const postsByYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = Number(
    post.data.pubDate.toLocaleDateString('en-US', {
      year: 'numeric',
      timeZone: SITE_TIMEZONE,
    }),
  );
  postsByYear.set(year, [...(postsByYear.get(year) ?? []), post]);
}

const tags = [...new Set(posts.map((post) => post.data.tags).flat())].sort();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Blog" description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="grid-layout flow flow-2">
      <section class="flow">
        <h1>Blog</h1>
        <p class="flow-1/2">Sometimes I write about things like...</p>
      </section>
      <section class="post-tags flow-0">
        {tags.map((tag) => (
          <a class="tag-link" href={`/tags/${tag}/`}>#{tag}</a>
        ))}
      </section>
      {[...postsByYear].map(([year, yearPosts]) => (
        <section class="flow flow-2">
          <SectionHeader title={year.toString()} />
          <ul class="list-item">
            {yearPosts.map((post) => (
              <ListItemPost
                id={post.id}
                title={post.data.title}
                date={post.data.pubDate}
              />
            ))}
          </ul>
        </section>
      ))}
    </main>
    <Footer />
  </body>
</html>
