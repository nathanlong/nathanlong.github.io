---
import BaseHead from '@components/BaseHead.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="grid-layout flow">
      <section class="flow">
        <h1>About Nathan</h1>
        <h2 class="subhead flow-0">Artist brain. Coder heart.</h2>
        <p>
          I'm a Designer-turned-Developer with over a decade of experience
          creating user interfaces for clients ranging from small startups to
          members of the Fortune 100.
        </p>
        <p>
          I originally thought I was going to be a{' '}
          <a href="https://en.wikipedia.org/wiki/Sequential_art">
            sequential artist
          </a>
          , but my love of computers led me to design and later into
          development. I made the switch to a full developer in 2022 when I
          joined <a href="#">Viget</a>, where I work now as a{' '}
          <strong>UI Developer</strong>.
        </p>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .subhead {
    font-size: 1.2rem;
  }
</style>
